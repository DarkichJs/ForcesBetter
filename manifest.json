{
  "manifest_version": 3,
  "name": "ForcesBetter — Codeforces, but nicer",
  "short_name": "ForcesBetter",
  "version": "1.2.0",
  "description": "Dark theme, a code editor with sample tests beside the statement, rounded cards and Easy/Medium/Hard tags for Codeforces.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "ForcesBetter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "*://codeforces.com/*",
        "*://*.codeforces.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/*",
        "*://*.codeforces.com/*"
      ],
      "css": [
        "src/styles.css"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://codeforces.com/*",
        "*://*.codeforces.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://codeforces.com/problemset/problem/*",
        "*://codeforces.com/contest/*/problem/*",
        "*://codeforces.com/gym/*/problem/*",
        "*://codeforces.com/group/*/contest/*/problem/*",
        "*://*.codeforces.com/problemset/problem/*",
        "*://*.codeforces.com/contest/*/problem/*",
        "*://*.codeforces.com/gym/*/problem/*",
        "*://*.codeforces.com/group/*/contest/*/problem/*"
      ],
      "js": [
        "vendor/ace/ace.js",
        "src/ace-setup.js",
        "vendor/ace/ext-language_tools.js",
        "vendor/ace/ext-searchbox.js",
        "vendor/ace/mode-c_cpp.js",
        "vendor/ace/mode-python.js",
        "vendor/ace/mode-java.js",
        "vendor/ace/mode-kotlin.js",
        "vendor/ace/mode-rust.js",
        "vendor/ace/mode-golang.js",
        "vendor/ace/mode-csharp.js",
        "vendor/ace/mode-javascript.js",
        "vendor/ace/mode-haskell.js",
        "vendor/ace/mode-pascal.js",
        "vendor/ace/mode-ruby.js",
        "vendor/ace/mode-scala.js",
        "vendor/ace/mode-d.js",
        "vendor/ace/mode-ocaml.js",
        "vendor/ace/mode-perl.js",
        "src/workspace.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://codeforces.com/profile/*",
        "*://*.codeforces.com/profile/*"
      ],
      "js": [
        "src/profile.js"
      ],
      "run_at": "document_end"
    }
  ]
}
